# Copy to .env.local. These match the devserver's hardcoded dev values —
# they are not secrets and must never be used anywhere real.

# Where the Go devserver listens. Server-side only; never exposed publicly.
BOT_URL=http://127.0.0.1:8080

# Bearer token for /webauth/redeem and /webauth/refresh.
WEBAUTH_API_TOKEN=dev-api-token-not-a-secret

# HMAC key the bot signs session tokens with, so this app can verify cookies
# locally. A DIFFERENT value from WEBAUTH_API_TOKEN, by design.
WEBAUTH_SIGNING_KEY=dev-signing-key-not-a-secret

# Same URL as BOT_URL, but reachable from the browser — the harness page calls
# the /dev/* routes directly. A real dashboard has no equivalent of this.
NEXT_PUBLIC_BOT_URL=http://127.0.0.1:8080
